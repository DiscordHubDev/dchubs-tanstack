{
  "name": "dchubs-tanstack",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --host 0.0.0.0 --force",
    "build": "NODE_ENV=production bun --bun vite build",
    "preview": "bun --bun vite preview",
    "deploy": "bun run build && wrangler deploy",
    "start": "bun run .output/server/index.mjs",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "format": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --bun ./src/scripts/migrate-debug.ts",
    "db:push": "drizzle-kit push",
    "db:deploy": "bunx drizzle-kit generate && bun run migrate-debug.ts",
    "db:export:sql": "drizzle-kit export --sql > src/drizzle/schema.export.sql",
    "db:apply:sql": "bun src/drizzle/apply-sql.ts src/drizzle/schema.export.sql",
    "db:sync:data": "bun src/drizzle/sync-data.ts",
    "db:migrate:sql": "set -a && . ./.env && set +a && test -n \"$DATABASE_URL\" && test -n \"$NEW_DATABASE_URL\" && bun run db:export:sql && bun run db:apply:sql && bun run db:sync:data",
    "db:migrate:data": "bun run db:migrate:sql",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@aws-sdk/lib-storage": "^3.1061.0",
    "@better-auth/drizzle-adapter": "1.6.9",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@t3-oss/env-core": "0.13.10",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.0",
    "@tanstack/react-start": "1.168.11",
    "@tanstack/react-table": "latest",
    "@tanstack/router-plugin": "1.168.11",
    "@unpic/react": "1.0.2",
    "better-auth": "1.6.9",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.9.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "effect": "3.21.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "0.577.0",
    "nitro": "npm:nitro-nightly@latest",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "react-toastify": "11.0.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "4.0.1",
    "sweetalert2": "11.26.24",
    "tailwind-merge": "3.0.2",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.3.6",
    "zod": "4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.31.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.1",
    "drizzle-kit": "^0.31.10",
    "lightningcss": "^1.32.0",
    "mime-types": "^3.0.2",
    "pg": "^8.21.0",
    "react-compiler-runtime": "^1.0.0",
    "react-security-scanner": "^1.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vite-plugin-inspect": "^11.4.1",
    "vitest": "^3.0.5",
    "wrangler": "^4.81.1"
  }
}