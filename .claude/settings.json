{
  "permissions": {
    "allow": [
      "Edit", "Write", "Bash",
      "WebFetch(domain:tanstack.com)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "for file in .env bun.lockb package.json src/drizzle/schema.ts; do if [ -f \"$file\" ]; then echo \"⚠️ [Safety Guard] Warning: You are about to modify a critical file: $file\"; fi; done"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun --bun run lint:fix && bun --bun run fmt && bunx tsc --noEmit"
          }
        ]
      }
    ]
  }
}
